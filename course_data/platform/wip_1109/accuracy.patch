     return p, t - p, err, cost
 
 
-def localize_hole(line, green, own, borrow=(), yardages=None, params=None):
+def canopy_sampler(path):
+    """lidar height-above-ground raster (vision_any/<slug>/raw/hag.tif) -> f(lats, lons) -> metres (nan off the
+    raster), for localize_course(canopy=). None when the file is missing / unreadable."""
+    try:
+        import rasterio
+        from pyproj import Transformer
+        with rasterio.open(path) as src:
+            a = src.read(1).astype(np.float32)
+            nd = src.nodata
+            tf, crs = src.transform, src.crs
+            units = str(src.tags().get("units", "")).split()
+        if nd is not None:
+            a[a == nd] = np.nan
+        if len(units) == 2 and units[1] == "m":                    # vision_any/fetch_any.py: uint8 in 0.25 m units
+            a *= float(units[0])
+        tr = Transformer.from_crs("EPSG:4326", crs, always_xy=True)
+        inv = ~tf
+    except Exception:                                              # noqa: BLE001  (optional evidence)
+        return None
+
+    def f(lats, lons):
+        x, y = tr.transform(np.asarray(lons, float), np.asarray(lats, float))
+        c, r = inv * (np.asarray(x), np.asarray(y))
